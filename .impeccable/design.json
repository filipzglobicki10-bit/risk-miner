      "html": "<div class=\"ds-vt ds-vt-bad\"><div class=\"ds-vb\"><span class=\"ds-vk\">Budżet (szacunek inwestora):</span> za mało o 2,4 mln zł</div><div class=\"ds-vs\">przy P80 bazy</div></div>",
      "css": ".ds-vt{border-radius:12px;padding:14px 16px;border:1px solid #D3DEE8;background:#fff;max-width:280px;transition:transform .2s cubic-bezier(.16,1,.3,1),box-shadow .2s}.ds-vt:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(11,42,69,.08)}.ds-vb{font-family:\"Barlow Semi Condensed\",\"Barlow\",system-ui,sans-serif;font-variant-numeric:tabular-nums;font-weight:700;font-size:22px;line-height:1.15;color:#0B2A45;margin:6px 0}.ds-vk{color:#0E2236;font-weight:600}.ds-vs{font-family:\"Barlow\",system-ui,sans-serif;font-size:13.5px;color:#4A5D72}.ds-vt-bad{background:#FCE6E6;border-color:#F2BDBF}.ds-vt-bad .ds-vb{color:#B31F27}.ds-vt-bad .ds-vk{color:#0E2236}"
    },
    {
