      "refersTo": "chip-ok",
      "description": "Ladder chips for risk level; water wash for pending.",
      "html": "<span class=\"ds-pill ds-ok\">poniżej P50</span> <span class=\"ds-pill ds-warn\">stan ostrzegawczy</span> <span class=\"ds-pill ds-bad\">stan alarmowy</span> <span class=\"ds-pill ds-info\">do weryfikacji</span>",
      "css": ".ds-pill{display:inline-block;padding:2px 9px;border-radius:999px;font-family:\"Barlow Semi Condensed\",\"Barlow\",system-ui,sans-serif;font-variant-numeric:tabular-nums;font-weight:700;font-size:12.5px;line-height:1.4;letter-spacing:.2px;border:1px solid transparent;white-space:nowrap}.ds-ok{background:#E2F3EA;color:#17703F;border-color:#B9E0C9}.ds-warn{background:#FFF6D6;color:#7A5600;border-color:#F0DC8E}.ds-bad{background:#FCE6E6;color:#B31F27;border-color:#F2BDBF}.ds-info{background:#E1EEF8;color:#0F5389;border-color:#BCD6EE}"
    },
