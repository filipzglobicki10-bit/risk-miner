  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one action colour: water. Main action on any sheet.",
      "html": "<button class=\"ds-btn-primary\">Analizuj</button>",
      "css": ".ds-btn-primary{font-family:\"Barlow\",system-ui,sans-serif;font-weight:600;font-size:14px;line-height:1.3;background:var(--water,#1668A8);color:#fff;border:1px solid var(--water,#1668A8);padding:8px 14px;border-radius:8px;cursor:pointer;transition:background .15s,box-shadow .15s,transform .15s cubic-bezier(.16,1,.3,1)}.ds-btn-primary:hover{background:var(--water-deep,#0F5389);border-color:var(--water-deep,#0F5389);box-shadow:0 4px 12px rgba(22,104,168,.25)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2px solid var(--water,#1668A8);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Neutral white button with hairline border.",
      "html": "<button class=\"ds-btn\">Pobierz raport</button>",
      "css": ".ds-btn{font-family:\"Barlow\",system-ui,sans-serif;font-weight:600;font-size:14px;line-height:1.3;background:#fff;color:#0E2236;border:1px solid #D3DEE8;padding:8px 14px;border-radius:8px;cursor:pointer;transition:background .15s,border-color .15s}.ds-btn:hover{border-color:#A9BDD0;background:#F6F9FC}.ds-btn:focus-visible{outline:2px solid #1668A8;outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Hairline field; focus turns the border water with a water-wash ring.",
      "html": "<label class=\"ds-f\">Wartość inwestycji<input class=\"ds-input\" placeholder=\"np. 12,5 mln zł\"></label>",
      "css": ".ds-f{display:flex;flex-direction:column;gap:5px;font-family:\"Barlow\",system-ui,sans-serif;font-size:13px;font-weight:600;color:#4A5D72}.ds-input{font-family:\"Barlow\",system-ui,sans-serif;font-size:15px;border:1px solid #D3DEE8;border-radius:8px;padding:8px 10px;background:#fff;color:#0E2236;transition:border-color .15s,box-shadow .15s}.ds-input:hover{border-color:#A9BDD0}.ds-input:focus{outline:none;border-color:#1668A8;box-shadow:0 0 0 3px #E1EEF8}"
    },
    {
